{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brigadacardgame",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "PARTIDAS", "class_name": "Partida" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Partida"] }]
}
